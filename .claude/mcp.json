{
  "mcpServers": {
    "lean-ctx": {
      "command": "./.devenv/profile/bin/lean-ctx",
      "args": []
    },
    "roam-code": {
      "command": "./.devenv/profile/bin/roam",
      "args": ["mcp"]
    },
    "context7": {
      "command": "./.devenv/profile/bin/context7-mcp",
      "args": []
    },
    "searxng": {
      "command": "bunx",
      "args": ["mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://localhost:4001"
      }
    },
    "maestro": {
      "command": "./.devenv/profile/bin/maestro",
      "args": ["mcp", "serve"]
    }
  }
}
