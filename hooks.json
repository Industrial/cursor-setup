{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": ".cursor/hooks/enforce-devenv.sh",
        "timeout": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/format-after-edit.sh",
        "timeout": 30
      }
    ],
    "preToolUse": [
      {
        "command": ".cursor/hooks/block-native-web-search.sh",
        "matcher": "WebSearch|WebFetch",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/block-native-read-search.sh",
        "matcher": "Read|Grep",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/block-native-code-search.sh",
        "matcher": "SemanticSearch",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/block-native-edit.sh",
        "matcher": "Write|StrReplace|Delete|Edit|ApplyPatch|EditNotebook",
        "timeout": 5
      },
      {
        "command": ".cursor/hooks/block-native-shell.sh",
        "matcher": "Shell|AwaitShell",
        "timeout": 5
      }
    ]
  }
}
